{
  "name": "quesuwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "setup": "node scripts/setup.js"
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "vite": "^7.0.0"
  },
  "description": "Self-hosted customizable questionnaires and anonymous feedback with file uploads.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DesuwaDev/Quesuwa.git"
  },
  "homepage": "https://github.com/DesuwaDev/Quesuwa#readme",
  "bugs": {
    "url": "https://github.com/DesuwaDev/Quesuwa/issues"
  }
