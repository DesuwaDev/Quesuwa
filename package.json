{
  "name": "quesuwa",
  "private": true,
  "version": "0.0.1-beta.5",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "setup": "node scripts/setup.js",
    "check:i18n": "node scripts/check-i18n.js",
    "prebuild": "npm run check:i18n",
    "pretest": "npm run check:i18n",
    "reset-password": "node scripts/reset-password.js",
    "test:e2e": "node --test tests/e2e/*.e2e.js"
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/compiler-dom": "^3.5.43",
    "@vue/compiler-sfc": "^3.5.43",
    "concurrently": "^9.2.0",
    "puppeteer-core": "^24.43.1",
    "qrcode": "^1.5.4",
    "vite": "^7.0.0",
    "vue": "^3.5.0"
  },
  "description": "Self-hosted customizable questionnaires and anonymous feedback with file uploads.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DesuwaDev/Quesuwa.git"
  },
  "homepage": "https://github.com/DesuwaDev/Quesuwa#readme",
  "bugs": {
    "url": "https://github.com/DesuwaDev/Quesuwa/issues"
  }
}
