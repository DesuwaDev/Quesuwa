# Generate a unique password of at least 16 characters before starting.
ADMIN_PASSWORD=
PORT=3100
HOST=127.0.0.1
DATA_DIR=./data
# Set to production behind HTTPS to enable Secure session cookies.
NODE_ENV=development
# Public HTTPS origin, e.g. https://feedback.example.com. No trailing slash.
PUBLIC_ORIGIN=
# Set to 1 only when exactly one trusted reverse proxy sits before this app.
TRUST_PROXY_HOPS=0
