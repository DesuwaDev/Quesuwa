# Initial owner account, created on first start. The password needs at least 16 characters.
# `npm run reset-password` also uses these values to recover access.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PORT=3100
HOST=127.0.0.1
DATA_DIR=./data
# Set to production behind HTTPS to enable Secure session cookies.
NODE_ENV=development
# Public HTTPS origin, e.g. https://feedback.example.com. No trailing slash.
PUBLIC_ORIGIN=
# Set to 1 only when exactly one trusted reverse proxy sits before this app.
TRUST_PROXY_HOPS=0

# Default server language: zh-CN or en. Browser preference can override UI language.
DEFAULT_LOCALE=zh-CN

# Total attachment storage quota in MB, including trash.
MAX_STORAGE_MB=1024
