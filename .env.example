# Everything here is optional. Without ADMIN_PASSWORD the first owner account is
# created in the web UI (/admin) using a one-time code printed to the server log.
# Default language, storage quota and proxy hops can be changed under System in
# the web UI; a value set here takes precedence and locks that setting.

# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# PUBLIC_ORIGIN=https://feedback.example.com
# TRUST_PROXY_HOPS=1
# DEFAULT_LOCALE=zh-CN
# MAX_STORAGE_MB=1024

# Listening address and data directory (the container image sets these itself).
# HOST=127.0.0.1
# PORT=3100
# DATA_DIR=./data
